# Adresse de base de l'API Laravel mobile (sans barre oblique finale)
# Sur un téléphone physique, remplacez localhost par l'adresse IP locale du serveur de développement.
EXPO_PUBLIC_API_URL=http://localhost:8000/api/mobile/v1

# Adresse publique du site, utilisée pour ouvrir la politique de confidentialité complète.
# En production : EXPO_PUBLIC_WEB_URL=https://votre-domaine.example
EXPO_PUBLIC_WEB_URL=http://localhost:8000